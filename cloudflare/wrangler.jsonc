{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bundlejs-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "BUNDLE_CACHE",
      "id": "d470a9afb4944a8ab5f70c45144bcfe4",
      "preview_id": "REPLACE_WITH_BUNDLE_CACHE_PREVIEW_ID"
    }
  ],
  // Re-enable this binding if you want persisted bundle artifacts for cached `?file` responses.
  // "r2_buckets": [
  //   {
  //     "binding": "BUNDLE_ARTIFACTS",
  //     "bucket_name": "bundlejs-api-artifacts",
  //     "preview_bucket_name": "bundlejs-api-artifacts-preview"
  //   }
  // ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BUNDLE_COORDINATOR",
        "class_name": "BundleCoordinator"
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    },
    "limits": {
      "subrequests": 10000
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BundleCoordinator"
      ]
    }
  ]
}